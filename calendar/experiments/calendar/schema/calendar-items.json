[
  {
    "namespace": "calendar.items",
    "types": [
      {
        "id": "CalendarItem",
        "type": "object",
        "description": "TODO split event/task. Add more jscalendar props. Use format: 'date'.",
        "properties": {
          "id": { "type": "string" },
          "calendarId": { "type": "string" },
          "type": { "type": "string", "enum": ["event", "task"] },
          "instance": { "type": "string", "optional": true },
          "format": { "$ref": "CalendarItemFormats" },
          "item": {
            "$ref": "RawCalendarItem",
            "description": "The item in the requested returnFormat, or in the jcal format if none was requested."
          },
          "metadata": { "type": "object", "additionalProperties": { "type": "any" }, "optional": true }
        }
      },
      {
        "id": "RawCalendarItem",
        "type": "any"
      },
      {
        "id": "CalendarItemFormats",
        "type": "string",
        "enum": ["ical", "jcal"]
      },
      {
        "id": "CalendarItemAlarm",
        "type": "object",
        "description": "TODO needs real structure",
        "properties": {
          "itemId": { "type": "string" },
          "action": { "type": "string" },
          "date": {
            "type": "string",
            "optional": true,
            "description": "The alarm time as an iCalendar date-time. Only present for an absolute alarm."
          },
          "offset": {
            "type": "string",
            "optional": true,
            "description": "The offset from the start or end of the item as an iCalendar duration. Only present for an alarm relative to the item."
          },
          "related": { "type": "string", "enum": ["absolute", "start", "end"] }
        }
      }
    ],
    "functions": [
      {
        "name": "get",
        "async": "callback",
        "type": "function",
        "parameters": [
          { "type": "string", "name": "calendarId" },
          { "type": "string", "name": "id" },
          {
            "type": "object",
            "name": "getOptions",
            "optional": true,
            "properties": {
              "returnFormat": { "$ref": "CalendarItemFormats", "optional": true }
            }
          },
          {
            "type": "function",
            "name": "callback",
            "optional": true,
            "parameters": [
              {
                "choices": [
                  { "$ref": "CalendarItem" },
                  { "type": "null" }
                ],
                "description": "The item, or null if there is no item with that id."
              }
            ]
          }
         ]
      },
      {
        "name": "query",
        "async": "callback",
        "type": "function",
        "parameters": [
          {
            "type": "object",
            "name": "queryOptions",
            "properties": {
              "returnFormat": { "$ref": "CalendarItemFormats", "optional": true },
              "id": { "type": "string", "optional": true },
              "calendarId": {
                "choices": [
                  { "type": "string" },
                  { "type": "array", "items": { "type": "string" } }
                ],
                "optional": true
              },
              "type": { "type": "string", "enum": ["event", "task"], "optional": true },
              "rangeStart": { "type": "string", "optional": true },
              "rangeEnd": { "type": "string", "optional": true },
              "expand": { "type": "boolean", "optional": true }
            }
          },
          {
            "type": "function",
            "name": "callback",
            "optional": true,
            "parameters": [
              {
                "type": "array",
                "items": { "$ref": "CalendarItem" },
                "description": "The items that match."
              }
            ]
          }
        ]
      },
      {
        "name": "create",
        "async": "callback",
        "type": "function",
        "parameters": [
          { "type": "string", "name": "calendarId" },
          {
            "name": "createProperties",
            "type": "object",
            "properties": {
              "id": { "type": "string", "optional": true },
              "type": { "type": "string", "enum": ["event", "task"] },
              "format": { "$ref": "CalendarItemFormats", "optional": true },
              "item": { "$ref": "RawCalendarItem" },
              "returnFormat": { "$ref": "CalendarItemFormats", "optional": true },
              "metadata": { "type": "object", "properties": {}, "additionalProperties": { "type": "any" }, "optional": true }
            }
          },
          {
            "type": "function",
            "name": "callback",
            "optional": true,
            "parameters": [
              {
                "$ref": "CalendarItem",
                "description": "The created item."
              }
            ]
          }
        ]
      },
      {
        "name": "update",
        "async": "callback",
        "type": "function",
        "parameters": [
          { "type": "string", "name": "calendarId" },
          { "type": "string", "name": "id" },
          {
            "name": "updateProperties",
            "type": "object",
            "properties": {
              "format": { "$ref": "CalendarItemFormats", "optional": true },
              "item": { "$ref": "RawCalendarItem" },
              "returnFormat": { "$ref": "CalendarItemFormats", "optional": true },
              "metadata": { "type": "object", "additionalProperties": { "type": "any" }, "optional": true }
            }
          },
          {
            "type": "function",
            "name": "callback",
            "optional": true,
            "parameters": [
              {
                "$ref": "CalendarItem",
                "description": "The updated item."
              }
            ]
          }
        ]
      },
      {
        "name": "move",
        "async": true,
        "type": "function",
        "parameters": [
          { "type": "string", "name": "fromCalendarId" },
          { "type": "string", "name": "id" },
          { "type": "string", "name": "toCalendarId" }
        ]
      },
      {
        "name": "remove",
        "async": true,
        "type": "function",
        "parameters": [
          { "type": "string", "name": "calendarId" },
          { "type": "string", "name": "id" }
        ]
      },
      {
        "name": "getCurrent",
        "async": "callback",
        "type": "function",
        "parameters": [
          {
            "type": "object",
            "name": "getOptions",
            "optional": true,
            "properties": {
              "returnFormat": { "$ref": "CalendarItemFormats", "optional": true }
            }
          },
          {
            "type": "function",
            "name": "callback",
            "optional": true,
            "parameters": [
              {
                "choices": [
                  { "$ref": "CalendarItem" },
                  { "type": "null" }
                ],
                "description": "The item shown in the current dialog, or null if there is none."
              }
            ]
          }
        ]
      }
    ],
    "events": [
      {
        "name": "onCreated",
        "type": "function",
        "parameters": [
          { "name": "item", "$ref": "CalendarItem" }
        ],
        "extraParameters": [
          {
            "type": "object",
            "optional": true,
            "properties": {
              "returnFormat": { "$ref": "CalendarItemFormats", "optional": true }
            }
          }
        ]
      },
      {
        "name": "onUpdated",
        "type": "function",
        "parameters": [
          { "name": "item", "$ref": "CalendarItem" },
          { "name": "changeInfo", "type": "object", "properties": {}, "description": "TODO needs properties" }
        ],
        "extraParameters": [
          {
            "type": "object",
            "optional": true,
            "properties": {
              "returnFormat": { "$ref": "CalendarItemFormats", "optional": true }
            }
          }
        ]
      },
      {
        "name": "onRemoved",
        "type": "function",
        "parameters": [
          { "type": "string", "name": "calendarId" },
          { "type": "string", "name": "id" }
        ]
      },
      {
        "name": "onAlarm",
        "type": "function",
        "parameters": [
          { "name": "item", "$ref": "CalendarItem" },
          { "name": "alarm", "$ref": "CalendarItemAlarm" }
        ],
        "extraParameters": [
          {
            "type": "object",
            "optional": true,
            "properties": {
              "returnFormat": { "$ref": "CalendarItemFormats", "optional": true }
            }
          }
        ]
      }
    ]
  }
]
